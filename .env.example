# Salin file ini menjadi .env (untuk lokal) dan isi juga nilai yang sama
# di Vercel > Project Settings > Environment Variables (untuk produksi).

# Email Service Account, didapat dari file JSON key di Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@nama-project.iam.gserviceaccount.com

# Private key dari file JSON key yang sama (field "private_key").
# PENTING: biarkan tanda \n apa adanya (literal), JANGAN diganti enter sungguhan.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ID spreadsheet (bagian di URL antara /d/ dan /edit)
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
